# APP_URL: public address of the site (payment callback, share links, meta tags).
APP_URL="https://mevent.example.ir"

# PostgreSQL connection (SQL_ADMIN_* is optional and only used for startup migrations)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# PORT: HTTP port for the Express server (default 3000)
PORT=3000

# TRUST_PROXY: number of reverse proxies in front of the server (used for client IPs / rate limiting).
TRUST_PROXY=1

# CORS_ORIGINS: optional comma-separated list of extra origins allowed to call the API.
CORS_ORIGINS=""

# ---------------------------------------------------------------------------
# Sign-in with an SMS code (the main login method).
# SMS_PROVIDER: kavenegar | smsir | console (console only prints the code to the server log;
# it is the default outside production, and production has no default).
SMS_PROVIDER="kavenegar"
# Kavenegar "verify/lookup": create a template whose single token is the code.
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""
# sms.ir "send/verify": template id with one parameter named CODE.
SMSIR_API_KEY=""
SMSIR_OTP_TEMPLATE_ID=""
# If both Kavenegar and sms.ir have keys, the one not chosen in SMS_PROVIDER is used automatically
# whenever the chosen one is unreachable or refuses (e.g. out of credit).
# Optional: override provider hosts (egress proxy, or local stubs in tests).
KAVENEGAR_BASE_URL=""
SMSIR_BASE_URL=""
SMS_BASE_URL=""
# Secret for hashing the codes stored in the database. Required in production; use a long random value:
#   openssl rand -hex 32
OTP_SECRET=""
# For Android Chrome to fill the code in by itself, the template text must end with this
# last line:  @your-domain.ir #%token%   (Kavenegar) or  @your-domain.ir #CODE  (sms.ir).

# Sign-in with Google (Firebase). Set it to "false" to hide the button and refuse Google tokens;
# hosts in Iran often cannot reach Google.
AUTH_GOOGLE_ENABLED="true"

# ---------------------------------------------------------------------------
# Payments (Zarinpal). Without a merchant id, production refuses paid checkouts;
# outside production (or with PAYMENT_ALLOW_SIMULATED=true) payments are simulated.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
PAYMENT_ALLOW_SIMULATED="false"

# Uploaded images: S3-compatible object storage (ArvanCloud, MinIO, ...). Recommended in production.
# While the storage is unreachable, uploads are kept in ./uploads and copied over automatically later.
# S3_ENDPOINT example: https://s3.ir-thr-at1.arvanstorage.ir
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Optional (default us-east-1; most S3-compatible services ignore it).
S3_REGION=""
# Older deployments: Google Cloud Storage bucket. Used only when S3_* is not set.
UPLOAD_BUCKET=""
# With neither, files stay in ./uploads (put it on a persistent volume).

# ---------------------------------------------------------------------------
# Map tiles. The browser tries these in order and switches to the next within ~2.5s if one does not load:
# MAP_TILE_URLS (your own / Iranian tile servers, "{z}/{x}/{y}" templates separated by "|"),
# then Map.ir (if MAPIR_API_KEY is set), then CARTO and OpenStreetMap. If none loads, the map is
# replaced by the address and Neshan/Balad links.
MAP_TILE_URLS=""
MAP_TILE_ATTRIBUTION=""
MAPIR_API_KEY=""

# ---------------------------------------------------------------------------
# Health checks for external services (SMS, payment, storage, Google, push). Each is probed in the
# background; a service that is down is skipped immediately and its plan B is used.
DEP_PROBE_INTERVAL_MS=120000
DEP_PROBE_TIMEOUT_MS=1500
DEP_COOLDOWN_MS=30000

# Web Push reminders/notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Scales every rate limit (1 = default).
RATE_LIMIT_MULTIPLIER=1
