# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PostgreSQL connection (SQL_ADMIN_* is optional and only used for startup migrations)
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""
SQL_ADMIN_USER=""
SQL_ADMIN_PASSWORD=""

# PORT: HTTP port for the Express server (default 3000)
PORT=3000

# TRUST_PROXY: number of reverse proxies in front of the server (used for client IPs / rate limiting).
TRUST_PROXY=1

# CORS_ORIGINS: optional comma-separated list of extra origins allowed to call the API.
CORS_ORIGINS=""

# ---------------------------------------------------------------------------
# Sign-in with an SMS code (the main login method).
# SMS_PROVIDER: kavenegar | smsir | console (console only prints the code to the server log;
# it is the default outside production, and production has no default).
SMS_PROVIDER="kavenegar"
# Kavenegar "verify/lookup": create a template whose single token is the code.
KAVENEGAR_API_KEY=""
KAVENEGAR_OTP_TEMPLATE=""
# sms.ir "send/verify": template id with one parameter named CODE.
SMSIR_API_KEY=""
SMSIR_OTP_TEMPLATE_ID=""
# Optional: override the provider host (egress proxy or a local stub in tests).
SMS_BASE_URL=""
# Secret for hashing the codes stored in the database. Required in production; use a long random value:
#   openssl rand -hex 32
OTP_SECRET=""
# For Android Chrome to fill the code in by itself, the template text must end with this
# last line:  @your-domain.ir #%token%   (Kavenegar) or  @your-domain.ir #CODE  (sms.ir).

# Sign-in with Google (Firebase). Set it to "false" to hide the button and refuse Google tokens;
# hosts in Iran often cannot reach Google.
AUTH_GOOGLE_ENABLED="true"

# ---------------------------------------------------------------------------
# Payments (Zarinpal). Without a merchant id, production refuses paid checkouts;
# outside production (or with PAYMENT_ALLOW_SIMULATED=true) payments are simulated.
ZARINPAL_MERCHANT_ID=""
ZARINPAL_SANDBOX="false"
PAYMENT_ALLOW_SIMULATED="false"

# Uploaded images: Cloud Storage bucket (recommended; container disks are wiped on restart).
# Leave empty to store files in ./uploads (development only).
UPLOAD_BUCKET=""

# Web Push reminders/notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Gemini models to try, in order (comma separated).
GEMINI_MODELS="gemini-3.6-flash,gemini-flash-latest,gemini-2.5-flash"

# Scales every rate limit (1 = default).
RATE_LIMIT_MULTIPLIER=1
